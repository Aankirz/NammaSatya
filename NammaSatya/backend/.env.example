# =============================================================================
# NammaSatya — Backend Environment Variables
# Copy this file to .env and fill in your values. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Elasticsearch (Elastic Cloud or self-hosted)
# -----------------------------------------------------------------------------
ES_URL=https://your-cluster.es.io:9243
ES_API_KEY=your_elasticsearch_api_key_here

# ELSER model deployed in your cluster via Kibana → ML → Trained Models
ELSER_MODEL_ID=.elser_model_2_linux-x86_64

# Index name (must match setup.py and rss_poller.py)
ES_INDEX=nammasatya-claims

# -----------------------------------------------------------------------------
# AWS Bedrock (Claude via Bedrock)
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Claude Sonnet — verdict generation (tool use)
BEDROCK_MODEL_ID=anthropic.claude-sonnet-4-5

# Claude Haiku — cheap reranker (0-100 relevance scores)
RERANKER_MODEL_ID=anthropic.claude-haiku-4-5-20251001

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# Set to "true" to enable CORS for local frontend dev
CORS_ALLOW_ALL=true
